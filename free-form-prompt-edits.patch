+def apply_edits(sheet: dict[str, Any], edits: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Append this turn's free-form edits to the sheet's edit history.
+
+    Each kept edit gets a stable ``id`` (its position in the whole conversation) so the
+    renderer can tell which ones are already on the drawing. An edit that undoes an earlier
+    one (same region, ``op`` = remove) drops the earlier edits for that region.
+    """
+    history = [dict(e) for e in (sheet.get(EDITS_KEY) or []) if isinstance(e, dict)]
+    next_id = max((int(e.get("id", 0)) for e in history), default=0) + 1
+    for e in edits:
+        instruction = str(e.get("instruction") or "").strip()[:200]
+        if not instruction:
+            continue
+        region = str(e.get("region") or "whole_head")
+        if region not in prompts.EDIT_REGIONS:
+            region = "whole_head"
+        op = str(e.get("op") or "change")
+        if op == "remove":
+            history = [h for h in history if h.get("region") != region]
+        elif op == "change":
+            # a newer change to a region supersedes the older one
+            history = [h for h in history if h.get("region") != region or h.get("op") == "add"]
+        history.append({"id": next_id, "region": region, "instruction": instruction, "op": op})
+        next_id += 1
+    return history[-EDITS_LIMIT:]
+
+

diff --git a/backend/tests/integration/test_live_prompts.py b/backend/tests/integration/test_live_prompts.py
new file mode 100644
index 0000000..d2aec4b
--- /dev/null
+++ b/backend/tests/integration/test_live_prompts.py
@@ -0,0 +1,84 @@
+"""A prompt edits the previous drawing: only the named part is repainted, once, and whatever
+the witness asks for is applied (even when no field or slider covers it)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import numpy as np
+import pytest
+
+from app.services.interview import live_render
+from tests.conftest import login, setup_session
+from tests.integration.test_live_render import library  # noqa: F401
+
+API = "/api/v1"
+
+
+async def _turn(client: httpx.AsyncClient, sid: str, wh: dict[str, str], text: str) -> Any:
+    r = await client.post(
+        f"{API}/sessions/{sid}/interview/turn", json={"text": text, "language": "en"}, headers=wh
+    )
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+async def _commit(client: httpx.AsyncClient, sid: str, wh: dict[str, str]) -> Any:
+    r = await client.post(
+        f"{API}/sessions/{sid}/interview/render", json={"commit": True, "wait_s": 10}, headers=wh
+    )
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+@pytest.mark.asyncio
+async def test_free_form_prompt_repaints_only_that_part_once(
+    client: httpx.AsyncClient,
+    users: dict[str, Any],
+    library: Any,  # noqa: F811
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    officer = await login(client, "officer1")
+    ctx = await setup_session(client, officer, language="en")
+    sid, wh = ctx["session_id"], ctx["witness_headers"]
+
+    await _turn(client, sid, wh, "He was about thirty, with a long nose and a wide jaw.")
+    first = await _commit(client, sid, wh)
+    assert first["kind"] == "portrait"
+
+    calls: list[dict[str, Any]] = []
+
+    async def fake_inpaint(
+        registry: Any,
+        img: np.ndarray,
+        mask: np.ndarray,
+        prompt: str,
+        seed: int | None,
+        strength: float | None = None,
+    ) -> tuple[np.ndarray, str, str]:
+        calls.append({"prompt": prompt, "strength": strength, "mask_px": int((mask > 0).sum())})
+        return img, "fake", "fake"
+
+    monkeypatch.setattr(live_render, "inpaint_region", fake_inpaint)
+
+    # a request no field or slider covers
+    body = await _turn(client, sid, wh, "give him a bandage on the nose")
+    assert [e["region"] for e in body["edits"]] == ["nose"]
+    second = await _commit(client, sid, wh)
+    assert second["version_id"] != first["version_id"]
+    assert len(calls) == 1
+    assert "bandage" in calls[0]["prompt"] and "the nose" in calls[0]["prompt"]
+    assert "wide jaw" not in calls[0]["prompt"]  # told only what changed
+    assert calls[0]["strength"] is None and calls[0]["mask_px"] > 0
+
+    # the same drawing again: nothing is repainted twice
+    await _commit(client, sid, wh)
+    assert len(calls) == 1
+
+    # a global request with no named part repaints the whole head, gently
+    await _turn(client, sid, wh, "make him look tired")
+    await _commit(client, sid, wh)
+    assert len(calls) == 2
+    assert "head and face" in calls[1]["prompt"]
+    assert calls[1]["strength"] == live_render.WHOLE_HEAD_STRENGTH
diff --git a/backend/tests/unit/test_live_edits.py b/backend/tests/unit/test_live_edits.py
new file mode 100644
index 0000000..9ea2b83
--- /dev/null
+++ b/backend/tests/unit/test_live_edits.py
@@ -0,0 +1,76 @@
+"""Free-form drawing prompts: the edit history and the repaint plan."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from app.services.interview import live_render as lr
+from app.services.interview.live import EDITS_KEY, apply_edits
+
+
+def _sheet(**kw: str) -> dict[str, Any]:
+    return {k: {"value": v} for k, v in kw.items()}
+
+
+def test_apply_edits_assigns_ids_and_keeps_history() -> None:
+    sheet: dict[str, Any] = {}
+    sheet[EDITS_KEY] = apply_edits(sheet, [{"region": "nose", "instruction": "bandage on nose"}])
+    sheet[EDITS_KEY] = apply_edits(sheet, [{"region": "hair", "instruction": "tied in a bun"}])
+    assert [e["id"] for e in sheet[EDITS_KEY]] == [1, 2]
+    assert [e["region"] for e in sheet[EDITS_KEY]] == ["nose", "hair"]
+
+
+def test_newer_change_supersedes_and_remove_undoes() -> None:
+    sheet: dict[str, Any] = {}
+    sheet[EDITS_KEY] = apply_edits(sheet, [{"region": "hair", "instruction": "long curly hair"}])
+    sheet[EDITS_KEY] = apply_edits(sheet, [{"region": "hair", "instruction": "short crew cut"}])
+    assert [e["instruction"] for e in sheet[EDITS_KEY]] == ["short crew cut"]
+    sheet[EDITS_KEY] = apply_edits(
+        sheet, [{"region": "hair", "instruction": "natural hair", "op": "remove"}]
+    )
+    assert [e["instruction"] for e in sheet[EDITS_KEY]] == ["natural hair"]
+
+
+def test_apply_edits_ignores_empty_and_unknown_region_goes_to_whole_head() -> None:
+    out = apply_edits(
+        {}, [{"region": "nose", "instruction": "  "}, {"region": "elbow", "instruction": "tired"}]
+    )
+    assert [(e["region"], e["instruction"]) for e in out] == [("whole_head", "tired")]
+
+
+def test_plan_repaints_only_the_changed_field_with_a_focused_text() -> None:
+    st = lr._Live()
+    st.base_fields = {"nose": "long", "jaw": "wide", "gender": "male"}
+    sheet = _sheet(nose="broad", jaw="wide", gender="male")
+    plan = lr._plan(st, sheet)
+    assert plan.regions == {"nose": ["nose: broad"]} and not plan.regen
+
+
+def test_plan_gender_change_regenerates_but_age_repaints_the_head() -> None:
+    st = lr._Live()
+    st.base_fields = {"gender": "male", "age_range": "30"}
+    assert lr._plan(st, _sheet(gender="female", age_range="30")).regen
+    plan = lr._plan(st, _sheet(gender="male", age_range="60"))
+    assert not plan.regen and plan.regions == {lr.WHOLE_HEAD: ["age range: 60"]}
+
+
+def test_plan_applies_each_free_form_edit_once() -> None:
+    st = lr._Live()
+    st.base_fields = {"gender": "male"}
+    sheet = _sheet(gender="male")
+    sheet[EDITS_KEY] = apply_edits(sheet, [{"region": "marks", "instruction": "scar on cheek"}])
+    plan = lr._plan(st, sheet)
+    assert plan.regions == {"marks": ["scar on cheek"]} and plan.edit_ids == [1]
+    st.applied_edits |= set(plan.edit_ids)
+    assert lr._plan(st, sheet).regions == {}
+
+
+def test_full_regeneration_keeps_earlier_edits_in_the_prompt() -> None:
+    sheet = _sheet(gender="male", age_range="30")
+    sheet[EDITS_KEY] = apply_edits(sheet, [{"region": "marks", "instruction": "scar on cheek"}])
+    assert "scar on cheek" in lr.realistic_prompt(sheet)
+
+
+def test_focused_prompt_mentions_only_the_change() -> None:
+    p = lr._focused_prompt(_sheet(gender="male", jaw="wide"), "nose", ["bandage"])
+    assert "bandage" in p and "the nose" in p and "wide" not in p

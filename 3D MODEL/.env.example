# ─── AI providers ────────────────────────────────────────────
# Only the provider named in AI_PROVIDER needs a key.
GROQ_API_KEY=
GEMINI_API_KEY=

# Which model drives natural-language face building.
# Options: groq | gemini
AI_PROVIDER=groq

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-flash-latest

# Optional: full path to blender.exe if it isn't auto-detected
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe

# ---------------------------------------------------------------------------
# Nishaan backend settings. Copy to .env and fill in the six keys below.
# Never commit .env. Values here are the defaults from app/config.py.
# ---------------------------------------------------------------------------

# ---- Secrets (required for cloud mode; leave empty to use mocks) -------------
GEMINI_API_KEY=            # Google AI Studio -> "Get API key"
GROQ_API_KEY=              # Groq console -> API Keys
CLOUDFLARE_ACCOUNT_ID=     # Cloudflare dashboard -> Workers & Pages -> Account ID
CLOUDFLARE_API_TOKEN=      # Cloudflare dashboard -> API Tokens -> "Workers AI" template
JWT_SECRET=                # python -c "import secrets; print(secrets.token_urlsafe(48))"
FILE_MASTER_KEY_B64=       # python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# ---- App -----------------------------------------------------------------------
APP_ENV=development                        # development | test | production
API_PREFIX=/api/v1                         # prefix for all REST routes
CORS_ORIGINS=http://localhost:5173         # comma separated allowed origins
LOG_LEVEL=INFO                             # python logging level
DATABASE_URL=sqlite+aiosqlite:///./data/nishaan.db   # SQLAlchemy async URL (Postgres later)
FILE_STORE_DIR=./data/files                # encrypted file blobs
AUTO_CREATE_DB=true                        # create tables on first start if alembic was not run

# ---- Auth ----------------------------------------------------------------------
JWT_ACCESS_TTL_MIN=15                      # access token lifetime (minutes)
JWT_REFRESH_TTL_DAYS=7                     # refresh token lifetime (days)
WITNESS_TOKEN_TTL_MIN=240                  # witness token lifetime (minutes)
LOGIN_RATE_LIMIT=10/minute                 # slowapi rate limit for POST /auth/login per IP
LOGIN_MAX_FAILURES=5                       # failed logins before lock
LOGIN_LOCK_MINUTES=15                      # lock duration

# ---- AI providers --------------------------------------------------------------
AI_MODE=cloud                              # cloud | mock (mock = fully offline, deterministic)
CLOUD_MODE_ACK=true                        # acknowledge that cloud mode sends demo data to Google/Groq/Cloudflare
LLM_PRIMARY=groq                           # groq | gemini | mock (groq is fastest for the live interview)
GEMINI_MODEL=gemini-3-flash-preview        # verify in Google AI Studio; names change
GEMINI_THINKING_BUDGET=0                   # 0 = thinking off (fast live interview); -1 = model default
GEMINI_TTS_MODEL=gemini-3.8-flash-tts      # interviewer voice when the browser has no voice for the language
GEMINI_TTS_VOICE=Kore
TTS_ENABLED=true
PROVIDER_COOLDOWN_S=300                    # skip a provider for this long after a quota error (429)
GROQ_LLM_MODEL=openai/gpt-oss-120b     # verify in the Groq console; names change
GROQ_LLM_FALLBACK_MODEL=openai/gpt-oss-20b  # tried at once when the main model is rate limited (limits are per model)
GROQ_REASONING_EFFORT=low                  # low keeps each interview turn around a second
GROQ_ASR_MODEL=whisper-large-v3            # Groq speech-to-text model
GROQ_BASE_URL=https://api.groq.com/openai/v1
IMAGE_PRIMARY=cloudflare                   # cloudflare | pollinations | mock
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell  # realistic, cheap (~60 neurons per portrait). Lucid Origin is more realistic but ~3,000 neurons each
CF_IMAGE_FALLBACK_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
CF_INPAINT_MODEL=@cf/runwayml/stable-diffusion-v1-5-inpainting
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
INPAINT_ENABLED=true                       # allow cloud inpainting for hair/skin/texture edits
PROVIDER_CACHE=true                        # cache provider responses (saves free quota during rehearsals)
HTTP_TIMEOUT_S=60                          # per request timeout
MAX_RETRIES=3                              # retries on 429/5xx with backoff
LLM_TEMPERATURE=0.2

# ---- Jobs ----------------------------------------------------------------------
JOBS_INLINE=false                          # true = run background jobs inside the request (tests)

# ---- Image pipeline ------------------------------------------------------------
FACE_SIZE_PX=1024                          # master image size
STABILITY_MAX_DRIFT_PX=3.0                 # locked-landmark drift warning threshold at 1024 px
STABILITY_MIN_SSIM_OUTSIDE=0.995           # SSIM outside the edit mask warning threshold
MAX_AUDIO_MB=20
MAX_IMAGE_MB=10
FACE_CHECK_MAX_YAW_DEG=15
FACE_CHECK_MAX_PITCH_DEG=15
FACE_CHECK_MIN_WIDTH_RATIO=0.35
GENERATION_MAX_ATTEMPTS=3                  # regenerate with a new seed when the face check fails
WARP_INTERNAL_PX=512                       # warp computed at this size then upscaled (keeps it under 1 s)
SKETCH_BLUR_SIGMA=9.0                      # pencil sketch: colour-dodge blur
SKETCH_XDOG_SIGMA=1.0                      # pencil sketch: XDoG base sigma
SKETCH_XDOG_K=1.6
SKETCH_XDOG_TAU=0.98
SKETCH_XDOG_PHI=10.0
SKETCH_EDGE_WEIGHT=0.55                    # how strongly XDoG edges multiply into the sketch
EXPORT_SIZE_PX=2048                        # PNG export size

# ---- Interview -----------------------------------------------------------------
INTERVIEW_MAX_QUESTIONS=12                 # hard stop for the interview engine
INTERVIEW_LIVE_MAX_QUESTIONS=24            # hard stop for the live voice sketch interview
